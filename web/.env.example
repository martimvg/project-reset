# Copy to .env.local for your own computer, or paste into Vercel -> Project -> Settings -> Environment Variables.
# From Supabase -> Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# From console.anthropic.com -> API keys (keep secret, server only):
ANTHROPIC_API_KEY=
# Optional
AI_MODEL=claude-sonnet-5-5
AI_MONTHLY_LIMIT=30
